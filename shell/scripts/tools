#!/bin/sh
# Install pinned protobuf plugins in this repository rather than the global Go bin directory.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
mkdir -p "$root/.cache/bin"
for tool in protoc-gen-go protoc-gen-go-grpc; do
    case "$tool" in
        protoc-gen-go) version=v1.36.12; display=v1.36.12; module=google.golang.org/protobuf/cmd/protoc-gen-go ;;
        protoc-gen-go-grpc) version=v1.6.2; display=1.6.2; module=google.golang.org/grpc/cmd/protoc-gen-go-grpc ;;
    esac
    if [ ! -x "$root/.cache/bin/$tool" ] || [ "$("$root/.cache/bin/$tool" --version)" != "$tool $display" ]; then
        GOBIN="$root/.cache/bin" "$root/shell/scripts/go" install "$module@$version"
    fi
done
